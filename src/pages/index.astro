  </div>

  <script>
    import { mount } from "@cloudflare/nimbus-docs/client";

    // 平台快捷键标签与搜索演示联动
    mount(".lp-page", (root) => {
      const kbd = root.querySelector<HTMLElement>("[data-search-kbd]");
      if (kbd) {
        const isApple = /Mac|iPhone|iPad|iPod/i.test(navigator.platform || navigator.userAgent);
        kbd.textContent = isApple ? "⌘K" : "Ctrl K";
      }

      const demoSearchBtn = root.querySelector<HTMLButtonElement>("[data-open-search]");
      const onOpenSearch = () => {
        const headerTrigger = document.querySelector<HTMLButtonElement>("[data-search-trigger]");
        headerTrigger?.click();
      };
      demoSearchBtn?.addEventListener("click", onOpenSearch);

      // 主题色板交互预览
      const themeDemo = root.querySelector<HTMLElement>("[data-theme-demo]");
      const brandCode = themeDemo?.querySelector<HTMLElement>('[data-theme-token="brand"]');
      const radiusCode = themeDemo?.querySelector<HTMLElement>('[data-theme-token="radius"]');
      const swatches = Array.from(themeDemo?.querySelectorAll<HTMLButtonElement>("[data-swatch-brand]") ?? []);

      const applySwatch = (btn: HTMLButtonElement) => {
        if (!themeDemo) return;
        const brand = btn.dataset.swatchBrand ?? "";
        const radius = btn.dataset.swatchRadius ?? "";
        const color = btn.dataset.swatchColor ?? "";
        themeDemo.style.setProperty("--preview-brand", color);
        themeDemo.style.setProperty("--preview-radius", radius);
        if (brandCode) brandCode.textContent = brand;
        if (radiusCode) radiusCode.textContent = radius;
        for (const item of swatches) {
          const active = item === btn;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        }
      };

      const onSwatchClick = (e: Event) => {
        const btn = e.currentTarget as HTMLButtonElement;
        applySwatch(btn);
      };
      swatches.forEach((btn) => btn.addEventListener("click", onSwatchClick));

      // 评审状态切换（自动演示后也可手动切换）
      const workbench = root.querySelector<HTMLElement>(".lp-workbench");
      const reviewBtn = workbench?.querySelector<HTMLButtonElement>("[data-review-btn]");
      const reviewChip = workbench?.querySelector<HTMLElement>("[data-review-chip], .lp-stage-review .lp-chip");
      const reviewMeta = workbench?.querySelector<HTMLElement>(".lp-review-meta");
      const reviewDot = workbench?.querySelector<HTMLElement>(".lp-stage-review .lp-dot");

      const setReviewApproved = (approved: boolean) => {
        if (reviewChip) {
          reviewChip.textContent = approved ? "Sam 已通过" : "等待 Sam";
          reviewChip.classList.toggle("lp-chip-warn", !approved);
          reviewChip.classList.toggle("lp-chip-ok", approved);
        }
        if (reviewBtn) {
          reviewBtn.textContent = approved ? "已签核发布" : "通过并发布";
          reviewBtn.classList.toggle("is-approved", approved);
          reviewBtn.setAttribute("aria-pressed", String(approved));
        }
        if (reviewMeta) {
          reviewMeta.textContent = approved ? "已发布 · 0 条评论" : "1 份草稿 · 0 条评论";
        }
        reviewDot?.classList.toggle("lp-dot-green", approved);
      };

      const onReviewClick = () => {
        const next = reviewBtn?.getAttribute("aria-pressed") !== "true";
        setReviewApproved(next);
      };
      reviewBtn?.addEventListener("click", onReviewClick);

      if (
        !("IntersectionObserver" in window) ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        return () => {
          demoSearchBtn?.removeEventListener("click", onOpenSearch);
          swatches.forEach((btn) => btn.removeEventListener("click", onSwatchClick));
          reviewBtn?.removeEventListener("click", onReviewClick);
        };
      }

      const timers: number[] = [];
      const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));

      // 导语逐句亮起揭示
      const tagline = root.querySelector<HTMLElement>("[data-lp-tagline]");
      let taglineObserver: IntersectionObserver | undefined;
      if (tagline) {
        const phrases = Array.from(tagline.querySelectorAll<HTMLElement>(".lp-phrase"));
        tagline.classList.add("lp-tagline-ready");
        taglineObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              phrases.forEach((phrase, idx) => {
                later(idx * 130, () => phrase.classList.add("is-lit"));
              });
              taglineObserver?.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -15% 0px", threshold: 0.25 },
        );
        taglineObserver.observe(tagline);
      }

      // [选择器, 起始延迟 ms, 每项间隔 ms, 动画类型]
      type Step = [string, number, number, string?];
      const stage = (el: HTMLElement, steps: Step[]) => {
        for (const [selector, start, gap, kind] of steps) {
          el.querySelectorAll<HTMLElement>(selector).forEach((node, i) => {
            node.dataset.lpStep = kind ?? "in";
            node.style.setProperty("--step-delay", `${start + i * gap}ms`);
          });
        }
        el.classList.add("lp-live");
      };

      const scenes: Array<{ selector: string; setup: (el: HTMLElement) => void; play?: (el: HTMLElement) => void }> = [
        {
          selector: ".lp-workbench",
          setup: (el) =>
            stage(el, [
              [".lp-stage-checks .lp-code-line", 200, 110],
              [".lp-stage-checks .lp-check-list li", 900, 160],
              [".lp-stage-checks .lp-stage-foot", 1600, 0],
              [".lp-stage-review .lp-review", 1700, 0],
              [".lp-stage-review .lp-quiet-card", 2000, 0],
              [".lp-stage-review .lp-stage-foot", 2800, 0],
              [".lp-stage-ship .lp-output-list li", 2900, 140],
              [".lp-stage-ship .lp-stage-foot", 3700, 0],
            ]),
          play: () => {
            later(2400, () => reviewBtn?.classList.add("is-pressed"));
            later(2680, () => {
              reviewBtn?.classList.remove("is-pressed");
              setReviewApproved(true);
            });
          },
        },
        {
          selector: ".lp-audience-grid",
          setup: (el) =>
            stage(el, [
              [".lp-check-list li", 150, 110],
              [".lp-mini-doc-brand, .lp-mini-doc-chip, .lp-mini-doc-title, .lp-mini-doc-line", 300, 110],
              [".lp-mini-bar-track i", 750, 140, "grow"],
              [".lp-mini-doc-tags span", 1250, 90],
              [".lp-mini-code pre", 550, 0],
              [".lp-tagcode", 1400, 0],
            ]),
        },
        {
          selector: ".lp-theme-panel",
          setup: (el) =>
            stage(el, [
              [".lp-theme-line", 200, 180],
              [".lp-swatch", 1100, 100, "scale"],
              [".lp-theme-preview", 1550, 0],
              [".lp-theme-preview-card", 1850, 0],
            ]),
        },
        {
          selector: ".lp-search-demo",
          setup: (el) => {
            stage(el, [
              [".lp-search-result:not(.lp-search-result-muted)", 1800, 0],
              [".lp-search-result-muted", 2100, 0],
              [".lp-search-foot", 2400, 0],
            ]);
          },
          play: (el) => {
            const span = el.querySelector<HTMLElement>("[data-search-query]");
            const searchKbd = el.querySelector<HTMLElement>("[data-search-kbd]");
            if (!span) return;
            const full = span.textContent ?? "";
            span.textContent = "";
            span.classList.add("is-typing");
            later(200, () => searchKbd?.classList.add("is-pressed"));
            later(450, () => searchKbd?.classList.remove("is-pressed"));
            [...full].forEach((_, i) => {
              later(550 + i * 65, () => {
                span.textContent = full.slice(0, i + 1);
              });
            });
            later(550 + full.length * 65 + 350, () => span.classList.remove("is-typing"));
          },
        },
      ];

      const entries = new Map<Element, (typeof scenes)[number]>();
      const playScene = (el: HTMLElement) => {
        if (el.classList.contains("is-playing")) return;
        const scene = entries.get(el);
        el.classList.add("is-playing");
        scene?.play?.(el);
        observer.unobserve(el);
      };

      const observer = new IntersectionObserver(
        (list) => {
          for (const item of list) {
            if (!item.isIntersecting) continue;
            playScene(item.target as HTMLElement);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.1 },
      );

      for (const scene of scenes) {
        const el = root.querySelector<HTMLElement>(scene.selector);
        if (!el) continue;
        scene.setup(el);
        entries.set(el, scene);
        if (el.getBoundingClientRect().top < window.innerHeight * 0.92) {
          playScene(el);
        } else {
          observer.observe(el);
        }
      }

      let sceneRaf = 0;
      const onSceneScroll = () => {
        if (sceneRaf) return;
        sceneRaf = window.requestAnimationFrame(() => {
          sceneRaf = 0;
          for (const el of entries.keys()) {
            const htmlEl = el as HTMLElement;
            if (htmlEl.classList.contains("is-playing")) continue;
            if (htmlEl.getBoundingClientRect().top < window.innerHeight * 0.92) {
              playScene(htmlEl);
            }
          }
        });
      };
      window.addEventListener("scroll", onSceneScroll, { passive: true });

      return () => {
        observer.disconnect();
        taglineObserver?.disconnect();
        window.removeEventListener("scroll", onSceneScroll);
        if (sceneRaf) window.cancelAnimationFrame(sceneRaf);
        timers.forEach((id) => window.clearTimeout(id));
        demoSearchBtn?.removeEventListener("click", onOpenSearch);
        swatches.forEach((btn) => btn.removeEventListener("click", onSwatchClick));
        reviewBtn?.removeEventListener("click", onReviewClick);
      };
    });

    mount(".lp-page", (root) => {
      const targets = Array.from(
        root.querySelectorAll<HTMLElement>("main > section:not(.lp-hero) > .lp-container"),
      );
      if (!("IntersectionObserver" in window) || targets.length === 0) return () => {};

      const revealEl = (el: Element) => {
        el.classList.add("is-visible");
        observer.unobserve(el);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            revealEl(entry.target);
          }
        },
        { rootMargin: "0px 0px -4% 0px", threshold: 0.01 },
      );

      const pending: HTMLElement[] = [];
      for (const el of targets) {
        // 已在首屏内的区块不做动画，避免闪烁
        if (el.getBoundingClientRect().top < window.innerHeight * 0.95) continue;
        el.classList.add("lp-reveal");
        pending.push(el);
        observer.observe(el);
      }

      // 锚点跳转或快速滚动越过某区块时，确保视口内及上方的区块都会显现
      let revealRaf = 0;
      const syncVisible = () => {
        if (revealRaf) return;
        revealRaf = window.requestAnimationFrame(() => {
          revealRaf = 0;
          const cutoff = window.innerHeight * 0.96;
          for (const el of pending) {
            if (el.classList.contains("is-visible")) continue;
            if (el.getBoundingClientRect().top < cutoff) {
              revealEl(el);
            }
          }
        });
      };
      window.addEventListener("scroll", syncVisible, { passive: true });
      window.addEventListener("hashchange", syncVisible);

      return () => {
        observer.disconnect();
        window.removeEventListener("scroll", syncVisible);
        window.removeEventListener("hashchange", syncVisible);
        if (revealRaf) window.cancelAnimationFrame(revealRaf);
      };
    });

    mount("[data-copy-command]", (root) => {
      const button = root.querySelector("[data-copy-trigger]") as HTMLButtonElement | null;
      const label = root.querySelector("[data-copy-label]") as HTMLElement | null;
      if (!button || !label) return () => {};
      const original = label.textContent;
      const text = root.getAttribute("data-copy-value") ?? "";
      let timer: number | undefined;

      const onClick = async () => {
        const tryClipboard = async () => {
          if (!navigator.clipboard) return false;
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {
            return false;
          }
        };

        let copied = await Promise.race([
          tryClipboard(),
          new Promise<boolean>((resolve) => window.setTimeout(() => resolve(false), 800)),
        ]);

        if (!copied) {
          const area = document.createElement("textarea");
          area.value = text;
          area.style.position = "fixed";
          area.style.opacity = "0";
          document.body.appendChild(area);
          area.select();
          copied = document.execCommand("copy");
          area.remove();
        }

        label.textContent = copied ? "已复制" : "复制失败";
        button.dataset.copied = copied ? "true" : "false";
        if (timer) window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          label.textContent = original;
          delete button.dataset.copied;
        }, 1600);
      };

      button.addEventListener("click", onClick);
      return () => {
        button.removeEventListener("click", onClick);
        if (timer) window.clearTimeout(timer);
      };
    });
  </script>
</BaseLayout>

<style>
  .lp-page {
    --lp-max: 1200px;
    --lp-line: var(--nb-border);
    --lp-line-strong: var(--nb-border-strong);
    --lp-surface: var(--nb-background);
    --lp-surface-alt: var(--nb-muted);
    --lp-card: var(--nb-card);
    --lp-elevated: var(--nb-card);
    --lp-muted-surface: var(--nb-muted);
    --lp-ink: var(--nb-foreground);
    --lp-muted-ink: var(--nb-muted-foreground);
    --lp-accent: #f08a3c;
    --lp-ease: cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--lp-surface);
    color: var(--lp-ink);
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  :global([data-mode="dark"]) .lp-page {
    --lp-surface: #000000;
    --lp-surface-alt: #181818;
    --lp-card: #181818;
    --lp-elevated: #1f1f1f;
    --lp-muted-surface: #272727;
    --lp-line: #272727;
    --lp-line-strong: #313131;
  }

  .lp-page ::selection {
    background: color-mix(in oklch, var(--nb-brand) 24%, transparent);
    color: var(--lp-ink);
  }

  .lp-page a:focus-visible,
  .lp-page button:focus-visible,
  .lp-page summary:focus-visible {
    outline: 2px solid var(--nb-ring);
    outline-offset: 2px;
    border-radius: 0.375rem;
  }

  .lp-container {
    width: min(100% - 3rem, var(--lp-max));
    margin-inline: auto;
  }

  /* ---- Header ---- */
  .lp-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--lp-line);
    background: color-mix(in oklch, var(--lp-surface) 84%, transparent);
    backdrop-filter: blur(16px);
  }

  .lp-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }

  .lp-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    color: var(--lp-ink);
    text-decoration: none;
    transition: opacity 300ms var(--lp-ease);
  }

  .lp-brand:hover {
    opacity: 0.8;
  }

  .lp-brand-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.5rem;
  }

  .lp-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: 1.5rem;
    margin-inline-end: auto;
  }

  .lp-nav a {
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 300ms var(--lp-ease),
      background-color 300ms var(--lp-ease);
  }

  .lp-nav a:hover {
    color: var(--lp-ink);
    background: var(--nb-accent);
  }

  .lp-nav a:active {
    transform: scale(0.98);
  }

  .lp-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .lp-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    color: var(--lp-muted-ink);
    transition:
      color 300ms var(--lp-ease),
      background-color 300ms var(--lp-ease),
      transform 300ms var(--lp-ease);
  }

  .lp-icon-link:hover {
    color: var(--lp-ink);
    background: var(--nb-accent);
  }

  .lp-icon-link:active {
    transform: scale(0.96);
  }

  .lp-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-inline-start: 0.5rem;
    min-height: 2rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--nb-primary);
    color: var(--nb-primary-foreground);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 300ms var(--lp-ease),
      opacity 300ms var(--lp-ease);
  }

  .lp-cta:hover {
    opacity: 0.9;
  }

  .lp-cta:active {
    transform: scale(0.98);
  }

  .lp-arrow {
    transition: transform 300ms var(--lp-ease);
  }

  .lp-cta:hover .lp-arrow,
  .lp-text-link:hover .lp-arrow,
  .lp-hero-links a:hover .lp-arrow {
    transform: translateX(3px);
  }

  .lp-mobile-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--lp-line);
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .lp-mobile-nav::-webkit-scrollbar {
    display: none;
  }

  .lp-mobile-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 300ms var(--lp-ease),
      background-color 300ms var(--lp-ease);
  }

  .lp-mobile-nav a:hover {
    color: var(--lp-ink);
    background: var(--nb-accent);
  }

  /* ---- Hero ---- */
  .lp-hero {
    position: relative;
    padding: clamp(4rem, 9vw, 6rem) 0 clamp(4rem, 8vw, 6rem);
    background: var(--lp-surface);
  }

  .lp-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .lp-avatars,
  .lp-review-avatars {
    display: inline-flex;
    align-items: center;
  }

  .lp-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-inline-start: -0.375rem;
    border-radius: 999px;
    border: 1.5px solid var(--lp-surface);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
  }

  .lp-avatar:first-child {
    margin-inline-start: 0;
  }

  .lp-avatar-you {
    background: var(--nb-foreground);
    color: var(--nb-background);
  }

  .lp-avatar-agent {
    background: var(--lp-accent);
    color: #181818;
  }

  .lp-avatar-review {
    background: #3d63b8;
    color: #fff;
  }

  .lp-title {
    display: flex;
    flex-direction: column;
    gap: 0.12em;
    max-width: 56rem;
    margin-top: 2rem;
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .lp-title-line {
    display: block;
  }

  .lp-title-strong {
    position: relative;
    display: inline-block;
    margin-inline-start: 0.14em;
    font-weight: 600;
  }

  .lp-title-muted {
    color: var(--lp-muted-ink);
    font-weight: 500;
  }

  .lp-select {
    position: relative;
    display: inline-block;
    margin-inline-start: 0.12em;
    padding: 0 0.16em;
    border-radius: 0.14em;
    background: color-mix(in oklch, var(--nb-brand) 14%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--nb-brand) 28%, transparent);
    color: var(--lp-ink);
  }

  .lp-select::after {
    position: absolute;
    top: 0.06em;
    bottom: 0.06em;
    right: -1px;
    width: 2.5px;
    border-radius: 1px;
    background: var(--lp-ink);
    content: "";
  }

  .lp-tag {
    position: absolute;
    z-index: 3;
    padding: 0.1875rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1rem;
    white-space: nowrap;
  }

  .lp-tag::after {
    position: absolute;
    width: 0.375rem;
    height: 0.375rem;
    background: inherit;
    content: "";
    rotate: 45deg;
  }

  .lp-tag-you {
    right: -1.75rem;
    bottom: 0.15em;
    background: var(--nb-foreground);
    color: var(--nb-background);
  }

  .lp-tag-you::after {
    left: -0.15rem;
    bottom: 0.25rem;
  }

  .lp-tag-agent {
    top: -1.75rem;
    right: 1.5rem;
    background: var(--lp-accent);
    color: #181818;
  }

  .lp-tag-agent::after {
    right: 0.625rem;
    bottom: -0.15rem;
  }

  .lp-lede {
    max-width: 42.5rem;
    margin-top: 1.5rem;
    color: var(--lp-muted-ink);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-wrap: pretty;
  }

  .lp-command {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    max-width: 100%;
    margin-top: 2rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.75rem;
    background: var(--lp-card);
    font-family: var(--nb-font-mono);
  }

  .lp-command-prefix {
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    user-select: none;
  }

  .lp-command-text {
    min-width: 0;
    color: var(--lp-ink);
    text-align: start;
    font-size: 0.875rem;
    line-height: 1.25rem;
    overflow-wrap: anywhere;
  }

  .lp-command-copy {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    min-height: 2rem;
    margin-inline-start: 0.25rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.5rem;
    background: var(--lp-muted-surface);
    color: var(--lp-muted-ink);
    cursor: pointer;
    font-family: var(--nb-font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    transition:
      color 300ms var(--lp-ease),
      border-color 300ms var(--lp-ease),
      background-color 300ms var(--lp-ease),
      transform 300ms var(--lp-ease);
  }

  .lp-command-copy:hover {
    border-color: var(--lp-line-strong);
    color: var(--lp-ink);
  }

  .lp-command-copy:active {
    transform: scale(0.98);
  }

  .lp-check-icon {
    display: none;
  }

  .lp-command-copy[data-copied="true"] {
    border-color: color-mix(in oklch, var(--nb-success) 40%, transparent);
    color: var(--nb-success);
  }

  .lp-command-copy[data-copied="true"] .lp-copy-icon {
    display: none;
  }

  .lp-command-copy[data-copied="true"] .lp-check-icon {
    display: block;
  }

  .lp-note {
    margin-top: 0.75rem;
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }

  .lp-hero-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding-block: 0.5rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 300ms var(--lp-ease);
  }

  .lp-hero-links a:hover {
    color: var(--lp-ink);
  }

  /* ---- Sections & Headings ---- */
  .lp-section {
    padding: clamp(4rem, 8vw, 6rem) 0;
    border-top: 1px solid var(--lp-line);
    background: var(--lp-surface);
  }

  .lp-audience,
  .lp-components {
    background: var(--lp-surface-alt);
  }

  .lp-kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lp-kicker::before {
    width: 0.5rem;
    height: 1px;
    background: var(--lp-muted-ink);
    content: "";
  }

  .lp-h2 {
    max-width: 56rem;
    color: var(--lp-ink);
    font-size: clamp(1.875rem, 4.2vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .lp-h2-line {
    display: block;
  }

  .lp-h2 em {
    color: var(--nb-brand);
    font-style: normal;
  }

  .lp-tagline-ready .lp-phrase {
    opacity: 0.28;
    transition: opacity 600ms var(--lp-ease);
  }

  .lp-tagline-ready .lp-phrase.is-lit {
    opacity: 1;
  }

  .lp-section-sub {
    max-width: 42rem;
    margin-top: 1rem;
    color: var(--lp-muted-ink);
    font-size: 1rem;
    line-height: 1.625rem;
    text-wrap: pretty;
  }

  .lp-section-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .lp-section-head-split {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  /* ---- Workbench ---- */
  .lp-workbench {
    overflow: hidden;
    border: 1px solid var(--lp-line);
    border-radius: 1rem;
    background: var(--lp-card);
  }

  .lp-wb-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 3rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--lp-line);
    background: var(--lp-muted-surface);
  }

  .lp-wb-dots {
    display: inline-flex;
    gap: 0.375rem;
  }

  .lp-wb-dots i {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--lp-line-strong);
  }

  .lp-wb-url {
    flex: 1;
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-wb-pill {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.25rem;
    background: var(--lp-card);
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
  }

  .lp-wb-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .lp-stage {
    display: flex;
    min-height: 25rem;
    flex-direction: column;
    padding: 1.5rem;
    border-inline-end: 1px solid var(--lp-line);
  }

  .lp-stage:last-child {
    border-inline-end: 0;
  }

  .lp-stage-label {
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lp-stage h3 {
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.5rem;
    text-wrap: balance;
  }

  .lp-editor,
  .lp-review,
  .lp-quiet-card {
    border: 1px solid var(--lp-line);
    border-radius: 0.75rem;
    background: var(--lp-elevated);
  }

  .lp-editor {
    margin-top: 1rem;
    overflow: hidden;
  }

  .lp-editor-head,
  .lp-mini-code-head,
  .lp-theme-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--lp-line);
    background: var(--lp-muted-surface);
  }

  .lp-file {
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-chip {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.25rem;
    background: var(--lp-card);
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
  }

  .lp-chip-warn {
    border-color: color-mix(in oklch, var(--nb-warning) 35%, transparent);
    background: var(--nb-warning-muted);
    color: var(--nb-warning-foreground);
  }

  .lp-code {
    padding: 0.75rem 0;
    overflow-x: auto;
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1.5rem;
  }

  .lp-code-line {
    display: flex;
    gap: 0.75rem;
    padding: 0 0.75rem;
    white-space: pre;
  }

  .lp-ln {
    width: 1rem;
    flex: none;
    color: var(--lp-muted-ink);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .lp-cm {
    color: var(--lp-muted-ink);
  }

  .lp-key {
    color: var(--nb-brand);
  }

  .lp-str {
    color: var(--nb-warning-foreground);
  }

  .lp-link {
    color: var(--nb-brand);
  }

  .lp-check-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .lp-check-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
  }

  .lp-check-list :global(svg) {
    flex: none;
    margin-top: 0.125rem;
    color: var(--nb-success);
  }

  .lp-stage-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--lp-line);
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .lp-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--lp-line-strong);
    flex: none;
  }

  .lp-dot-green {
    background: var(--nb-success);
  }

  .lp-review {
    margin-top: 1rem;
    padding: 1rem;
  }

  .lp-review-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .lp-review-copy {
    margin-top: 0.75rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .lp-review-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--lp-line);
  }

  .lp-button-dark {
    padding: 0.375rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    background: var(--nb-primary);
    color: var(--nb-primary-foreground);
    cursor: pointer;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    transition:
      background-color 300ms var(--lp-ease),
      color 300ms var(--lp-ease),
      border-color 300ms var(--lp-ease),
      transform 300ms var(--lp-ease);
  }

  .lp-button-dark:hover {
    opacity: 0.9;
  }

  .lp-button-dark:active {
    transform: scale(0.98);
  }

  .lp-button-dark.is-approved {
    border-color: color-mix(in oklch, var(--nb-success) 35%, transparent);
    background: var(--nb-success-muted);
    color: var(--nb-success-foreground);
  }

  .lp-review-meta {
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .lp-quiet-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.75rem;
    color: var(--lp-muted-ink);
  }

  .lp-quiet-card :global(svg) {
    flex: none;
    margin-top: 0.125rem;
    color: var(--nb-brand);
  }

  .lp-quiet-card strong {
    display: block;
    color: var(--lp-ink);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
  }

  .lp-quiet-card span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  .lp-output-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1rem;
    margin-bottom: 1rem;
    border-top: 1px solid var(--lp-line);
  }

  .lp-output-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--lp-line);
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-output-list li :global(svg) {
    color: var(--nb-brand);
  }

  .lp-output-name {
    overflow: hidden;
    color: var(--lp-ink);
    font-family: var(--nb-font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lp-output-meta {
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  /* ---- Audience ---- */
  .lp-audience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .lp-audience-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--lp-line);
    border-radius: 1rem;
    background: var(--lp-card);
    transition:
      transform 500ms var(--lp-ease),
      border-color 300ms var(--lp-ease);
  }

  .lp-audience-card:hover {
    transform: translateY(-2px);
    border-color: var(--lp-line-strong);
  }

  .lp-label {
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lp-audience-card h3 {
    margin-top: 0.75rem;
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lp-mini-doc,
  .lp-mini-code {
    margin-top: auto;
    padding-top: 0;
    border: 1px solid var(--lp-line);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .lp-audience-card .lp-check-list {
    margin-bottom: 1.5rem;
  }

  .lp-mini-doc {
    padding: 1rem;
    background: var(--lp-elevated);
  }

  .lp-mini-doc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-mini-doc-brand {
    font-weight: 600;
    color: var(--lp-ink);
  }

  .lp-mini-doc-chip {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.25rem;
    background: var(--lp-card);
  }

  .lp-mini-doc-title {
    margin-top: 1rem !important;
    color: var(--lp-ink);
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .lp-mini-doc-line {
    margin-top: 0.25rem !important;
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-mini-doc-bars {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .lp-mini-bar-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 0.5rem;
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .lp-mini-bar-row > span:last-child {
    text-align: end;
    color: var(--lp-ink);
  }

  .lp-mini-bar-track {
    display: block;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--lp-muted-surface);
    overflow: hidden;
  }

  .lp-mini-bar-track i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--nb-brand);
  }

  .lp-mini-doc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
  }

  .lp-mini-doc-tags span {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.25rem;
    background: var(--lp-card);
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-mini-code {
    background: #181818;
    border-color: #272727;
  }

  .lp-mini-code-head {
    border-bottom-color: #272727;
    background: #1f1f1f;
  }

  .lp-mini-code .lp-file {
    color: #b4b4b4;
  }

  .lp-mini-code .lp-chip {
    border-color: #313131;
    background: #272727;
    color: #e4e4e7;
  }

  .lp-mini-code pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    color: #e6e6e6;
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1.5rem;
  }

  .lp-mini-code .lp-cm {
    color: #9ca3af;
  }

  .lp-mini-code .lp-key {
    color: #9fb5e8;
  }

  .lp-mini-code .lp-str {
    color: #e7c38f;
  }

  .lp-tagcode {
    color: #b8a6e8;
  }

  /* ---- Theme Panel ---- */
  .lp-theme-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .lp-theme-panel {
    --preview-brand: var(--nb-brand);
    --preview-radius: 0.5rem;
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--lp-line);
    border-radius: 1rem;
    background: var(--lp-card);
  }

  .lp-theme-bar span:first-child {
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--lp-muted-ink);
  }

  .lp-theme-code {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1.5rem;
  }

  .lp-theme-line {
    display: block;
    white-space: pre;
  }

  .lp-swatches {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1rem 1rem;
  }

  .lp-swatch {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.375rem;
    border: 1px solid var(--lp-line-strong);
    cursor: pointer;
    transition:
      transform 300ms var(--lp-ease),
      border-color 300ms var(--lp-ease);
  }

  .lp-swatch:hover {
    transform: translateY(-1px);
  }

  .lp-swatch:active {
    transform: scale(0.94);
  }

  .lp-swatch.is-active {
    outline: 2px solid var(--lp-ink);
    outline-offset: 2px;
  }

  .lp-swatch-ink {
    background: #27272a;
  }

  .lp-swatch-brand {
    background: #3b63a8;
  }

  .lp-swatch-paper {
    background: #2b7a5b;
  }

  .lp-swatch-accent {
    background: #c96f2d;
  }

  .lp-theme-preview {
    margin: 0 1rem 1rem;
    padding: 1rem;
    border: 1px solid var(--lp-line);
    border-radius: var(--preview-radius);
    background: var(--lp-muted-surface);
    transition: border-radius 500ms var(--lp-ease);
  }

  .lp-theme-preview-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--preview-brand);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    transition: color 300ms var(--lp-ease);
  }

  .lp-theme-preview p {
    margin-top: 0.75rem !important;
    color: var(--lp-ink);
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .lp-theme-preview-line {
    display: block;
    width: 70%;
    height: 0.375rem;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--lp-muted-ink) 28%, transparent);
  }

  .lp-theme-preview-line.short {
    width: 45%;
  }

  .lp-theme-preview-card {
    margin-top: 1rem;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--preview-brand) 35%, var(--lp-line));
    border-radius: calc(max(var(--preview-radius) - 0.125rem, 0.25rem));
    background: var(--lp-card);
    transition:
      border-radius 500ms var(--lp-ease),
      border-color 300ms var(--lp-ease);
  }

  .lp-theme-preview-card strong {
    display: block;
    color: var(--preview-brand);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition: color 300ms var(--lp-ease);
  }

  .lp-theme-preview-card span {
    display: block;
    margin-top: 0.25rem;
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-theme-foot {
    margin: 0;
    padding: 0 1rem 1rem;
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  /* ---- Features ---- */
  .lp-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .lp-feature {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--lp-line);
    border-radius: 1rem;
    background: var(--lp-card);
    transition:
      transform 500ms var(--lp-ease),
      border-color 300ms var(--lp-ease);
  }

  .lp-feature:hover {
    transform: translateY(-2px);
    border-color: var(--lp-line-strong);
  }

  .lp-feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.5rem;
    color: var(--nb-brand);
    background: var(--lp-muted-surface);
  }

  .lp-feature h3 {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 600;
  }

  .lp-feature p {
    margin-top: 0.25rem;
    margin-bottom: 1rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .lp-feature-foot {
    display: block;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--lp-line);
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    font-variant-numeric: tabular-nums;
  }

  /* ---- Spotlight Search ---- */
  .lp-spotlight-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .lp-spotlight-copy .lp-text-link {
    margin-top: 1.5rem;
  }

  .lp-search-demo {
    padding: 1.25rem;
    border: 1px solid var(--lp-line);
    border-radius: 1rem;
    background: var(--lp-card);
  }

  .lp-search-bar {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.5rem;
    background: var(--lp-muted-surface);
    color: var(--lp-ink);
    cursor: pointer;
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-align: start;
    transition:
      border-color 300ms var(--lp-ease),
      transform 300ms var(--lp-ease);
  }

  .lp-search-bar:hover {
    border-color: var(--lp-line-strong);
  }

  .lp-search-bar:active {
    transform: scale(0.99);
  }

  .lp-search-bar :global(svg) {
    flex: none;
    color: var(--lp-muted-ink);
  }

  .lp-search-bar span {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lp-search-bar kbd {
    flex: none;
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.25rem;
    background: var(--lp-card);
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-search-result {
    margin-top: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.5rem;
    background: var(--lp-elevated);
  }

  .lp-search-result-muted {
    background: var(--lp-muted-surface);
  }

  .lp-search-breadcrumb {
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.04em;
  }

  .lp-search-title {
    margin-top: 0.25rem !important;
    color: var(--lp-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
  }

  .lp-search-result-muted .lp-search-title {
    color: var(--lp-muted-ink);
    font-weight: 500;
  }

  .lp-search-snippet {
    margin-top: 0.25rem !important;
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  .lp-search-url {
    display: block;
    margin-top: 0.5rem;
    color: var(--nb-brand);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-search-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--lp-line);
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .lp-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding-block: 0.5rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 300ms var(--lp-ease);
  }

  .lp-text-link:hover {
    color: var(--lp-ink);
  }

  /* ---- Components Showcase ---- */
  .lp-component-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .lp-component-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--lp-line);
    border-radius: 1rem;
    background: var(--lp-card);
    transition:
      transform 500ms var(--lp-ease),
      border-color 300ms var(--lp-ease);
  }

  .lp-component-card:hover {
    transform: translateY(-2px);
    border-color: var(--lp-line-strong);
  }

  .lp-component-label {
    display: block;
    margin-bottom: 1rem;
    color: var(--lp-muted-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-component-card :global(.aside-card),
  .lp-component-card :global(.steps-list),
  .lp-component-card :global([data-nb-pm]) {
    margin-block: 0;
  }

  .lp-component-card :global(code:not([data-nb-pm-code])),
  .lp-faq-list details code {
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    background: var(--nb-code-tint);
    color: var(--lp-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.8125em;
  }

  .lp-component-card :global(kbd) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--lp-line-strong);
    border-radius: 0.25rem;
    background: var(--lp-muted-surface);
    color: var(--lp-ink);
    font-family: var(--nb-font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
  }

  /* ---- FAQ ---- */
  .lp-faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  .lp-faq-list {
    border-top: 1px solid var(--lp-line);
  }

  .lp-faq-list details {
    border-bottom: 1px solid var(--lp-line);
  }

  .lp-faq-list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    color: var(--lp-ink);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 500;
    list-style: none;
    transition: color 300ms var(--lp-ease);
  }

  .lp-faq-list summary:hover {
    color: var(--lp-muted-ink);
  }

  .lp-faq-list summary::-webkit-details-marker {
    display: none;
  }

  .lp-faq-list summary :global(svg) {
    flex: none;
    color: var(--lp-muted-ink);
    transition: transform 300ms var(--lp-ease);
  }

  .lp-faq-list details[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  .lp-faq-list details p {
    max-width: 42rem;
    margin: 0 0 1.25rem !important;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  /* ---- Final CTA ---- */
  .lp-final {
    padding: clamp(5rem, 10vw, 7.5rem) 0;
    border-top: 1px solid var(--lp-line);
    background: var(--lp-surface-alt);
  }

  .lp-final-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .lp-final-title {
    max-width: 48rem;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .lp-command-large {
    margin-top: 2rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
  }

  /* ---- Footer ---- */
  .lp-footer {
    padding: 4rem 0 2rem;
    border-top: 1px solid var(--lp-line);
    background: var(--lp-surface);
  }

  .lp-footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .lp-footer-brand p {
    max-width: 20rem;
    margin-top: 1rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  .lp-footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .lp-footer-col h3 {
    margin-bottom: 0.5rem;
    color: var(--lp-ink);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
  }

  .lp-footer-col a {
    padding-block: 0.25rem;
    color: var(--lp-muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-decoration: none;
    transition: color 300ms var(--lp-ease);
  }

  .lp-footer-col a:hover {
    color: var(--lp-ink);
  }

  .lp-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--lp-line);
    color: var(--lp-muted-ink);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .lp-back-top {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    color: var(--lp-muted-ink);
    text-decoration: none;
    transition:
      color 300ms var(--lp-ease),
      background-color 300ms var(--lp-ease);
  }

  .lp-back-top:hover {
    color: var(--lp-ink);
    background: var(--nb-accent);
  }

  /* ---- Motion (opt-in when reduced motion is off) ---- */
  @media (prefers-reduced-motion: no-preference) {
    .lp-eyebrow {
      animation: lp-rise 600ms var(--lp-ease) both;
    }

    .lp-title {
      animation: lp-rise 700ms 80ms var(--lp-ease) both;
    }

    .lp-lede {
      animation: lp-rise 700ms 140ms var(--lp-ease) both;
    }

    .lp-command {
      animation: lp-rise 700ms 200ms var(--lp-ease) both;
    }

    .lp-note {
      animation: lp-rise 700ms 240ms var(--lp-ease) both;
    }

    .lp-hero-links {
      animation: lp-rise 700ms 280ms var(--lp-ease) both;
    }

    .lp-select::after {
      animation: lp-caret 1.1s step-end infinite;
    }

    .lp-faq-list details::details-content {
      interpolate-size: allow-keywords;
      overflow: clip;
      contain: layout;
      transition: block-size, content-visibility, display;
      transition-duration: 300ms;
      transition-timing-function: var(--lp-ease);
      transition-behavior: allow-discrete;
    }

    .lp-faq-list details:not([open])::details-content {
      block-size: 0;
    }

    /* 场景演示：进入视口后按顺序播放一次（由脚本添加 lp-live / is-playing） */
    .lp-live [data-lp-step] {
      opacity: 0;
    }

    .lp-live [data-lp-step="grow"] {
      opacity: 1;
      transform: scaleX(0);
      transform-origin: left;
    }

    .lp-live [data-lp-step="scale"] {
      opacity: 1;
      transform: scale(0);
    }

    .is-playing [data-lp-step] {
      animation: lp-step-in 600ms var(--step-delay, 0ms) var(--lp-ease) both;
    }

    .is-playing [data-lp-step="grow"] {
      animation-name: lp-step-grow;
      animation-duration: 700ms;
    }

    .is-playing [data-lp-step="scale"] {
      animation-name: lp-step-scale;
      animation-duration: 500ms;
    }

    .is-playing .lp-check-list li :global(svg) {
      animation: lp-step-scale 500ms calc(var(--step-delay, 0ms) + 120ms) var(--lp-ease) both;
    }

    .lp-live .lp-button-dark.is-pressed {
      animation: lp-press 320ms var(--lp-ease);
    }

    .lp-reveal {
      opacity: 0;
      transform: translateY(32px);
      transition:
        opacity 700ms var(--lp-ease),
        transform 700ms var(--lp-ease);
    }

    .lp-reveal.is-visible {
      opacity: 1;
      transform: none;
    }
  }

  .lp-chip-ok {
    border-color: color-mix(in oklch, var(--nb-success) 35%, transparent);
    background: var(--nb-success-muted);
    color: var(--nb-success-foreground);
  }

  .lp-search-bar span.is-typing::after {
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-inline-start: 2px;
    background: var(--lp-ink);
    vertical-align: -0.15em;
    content: "";
    animation: lp-caret 1.1s step-end infinite;
  }

  .lp-live .lp-search-bar kbd.is-pressed {
    border-color: var(--lp-line-strong);
    background: var(--nb-accent);
    color: var(--lp-ink);
    transform: scale(0.94);
    transition:
      transform 200ms var(--lp-ease),
      background-color 200ms var(--lp-ease);
  }

  @keyframes lp-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lp-caret {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @keyframes lp-step-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lp-step-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes lp-step-scale {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes lp-press {
    40% {
      transform: scale(0.95);
    }
  }

  /* ---- Responsive ---- */
  @media (max-width: 1000px) {
    .lp-wb-grid {
      grid-template-columns: 1fr;
    }

    .lp-stage {
      min-height: 0;
      border-inline-end: 0;
      border-bottom: 1px solid var(--lp-line);
    }

    .lp-stage:last-child {
      border-bottom: 0;
    }

    .lp-audience-grid,
    .lp-theme-grid,
    .lp-spotlight-grid,
    .lp-faq-grid {
      grid-template-columns: 1fr;
    }

    .lp-feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .lp-nav {
      display: none;
    }

    .lp-mobile-nav {
      display: flex;
    }
  }

  @media (max-width: 760px) {
    .lp-container {
      width: min(100% - 2rem, var(--lp-max));
    }

    .lp-header-inner {
      height: 3.75rem;
    }

    .lp-actions {
      gap: 0.25rem;
    }

    .lp-icon-link {
      display: none;
    }

    .lp-cta {
      min-height: 2rem;
      padding: 0.375rem 0.75rem;
      font-size: 0.875rem;
    }

    .lp-title {
      margin-top: 1.5rem;
      font-size: clamp(2.125rem, 9.5vw, 3rem);
    }

