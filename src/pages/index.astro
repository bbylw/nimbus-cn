  <script>
    import { mount } from "@cloudflare/nimbus-docs/client";

    // 页头滚动状态与站内搜索演示预设
    mount(".lp-page", (root) => {
      const header = root.querySelector<HTMLElement>("[data-lp-header]");
      const updateHeader = () => {
        if (!header) return;
        if (window.scrollY > 12) header.setAttribute("data-scrolled", "true");
        else header.removeAttribute("data-scrolled");
      };
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      // Band 1: 指针感应网格聚光
      const heroEl = root.querySelector<HTMLElement>("[data-lp-hero]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let heroGridRaf = 0;
      let nextHeroX = 0;
      let nextHeroY = 0;

      const onHeroPointerMove = (e: PointerEvent) => {
        if (!heroEl || reducedMotion || e.pointerType === "touch") return;
        const rect = heroEl.getBoundingClientRect();
        nextHeroX = e.clientX - rect.left;
        nextHeroY = e.clientY - rect.top;
        if (heroGridRaf) return;
        heroGridRaf = window.requestAnimationFrame(() => {
          heroGridRaf = 0;
          heroEl.style.setProperty("--mx", `${nextHeroX}px`);
          heroEl.style.setProperty("--my", `${nextHeroY}px`);
          heroEl.setAttribute("data-grid-active", "true");
        });
      };

      const onHeroPointerLeave = () => {
        heroEl?.removeAttribute("data-grid-active");
      };

      if (heroEl && !reducedMotion) {
        heroEl.addEventListener("pointermove", onHeroPointerMove);
        heroEl.addEventListener("pointerleave", onHeroPointerLeave);
      }

      // Band 1: 包管理器命令行即时切换
      const pmCommands: Record<string, string> = {
        bun: "bun create @cloudflare/nimbus-docs@latest my-docs --yes",
        pnpm: "pnpm create @cloudflare/nimbus-docs@latest my-docs --yes",
        npm: "npm create @cloudflare/nimbus-docs@latest my-docs -- --yes",
      };
      const heroCmdWrap = root.querySelector<HTMLElement>(".lp-command-with-pm");
      const heroCmdCode = heroCmdWrap?.querySelector<HTMLElement>("[data-copy-code]");
      const pmButtons = Array.from(
        heroCmdWrap?.querySelectorAll<HTMLButtonElement>("[data-pm]") ?? [],
      );

      const onPmClick = (e: Event) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const pm = btn.dataset.pm ?? "bun";
        const nextCmd = pmCommands[pm];
        if (!nextCmd || !heroCmdWrap || !heroCmdCode) return;
        heroCmdWrap.setAttribute("data-copy-value", nextCmd);
        heroCmdCode.textContent = nextCmd;
        for (const item of pmButtons) {
          item.setAttribute("aria-checked", String(item === btn));
        }
      };
      pmButtons.forEach((btn) => btn.addEventListener("click", onPmClick));

      // Band 1: 双端编译工作台选项卡、实时 MDX 编辑器、校验注入/修复与 X-Ray 透视幕帘
      const stageTabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-stage-tab]"));
      const stagePanels = Array.from(root.querySelectorAll<HTMLElement>("[data-stage-panel]"));

      const selectStageTab = (key: string, focusTab = false) => {
        for (const tab of stageTabs) {
          const active = tab.dataset.stageTab === key;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          if (active && focusTab) tab.focus();
        }
        for (const panel of stagePanels) {
          panel.hidden = panel.dataset.stagePanel !== key;
        }
      };

      const onStageClick = (e: Event) => {
        const btn = e.currentTarget as HTMLButtonElement;
        if (btn.dataset.stageTab) selectStageTab(btn.dataset.stageTab);
      };

      const onStageKeyDown = (e: KeyboardEvent) => {
        const idx = stageTabs.indexOf(e.currentTarget as HTMLButtonElement);
        if (idx === -1) return;
        let nextIdx = -1;
        if (e.key === "ArrowRight") nextIdx = (idx + 1) % stageTabs.length;
        else if (e.key === "ArrowLeft") nextIdx = (idx - 1 + stageTabs.length) % stageTabs.length;
        if (nextIdx >= 0) {
          e.preventDefault();
          const key = stageTabs[nextIdx]?.dataset.stageTab;
          if (key) selectStageTab(key, true);
        }
      };

      stageTabs.forEach((tab) => {
        tab.addEventListener("click", onStageClick);
        tab.addEventListener("keydown", onStageKeyDown);
      });

      interface FilePreset {
        route: string;
        showBars: boolean;
        source: string;
      }

      const filePresets: Record<string, FilePreset> = {
        alerts: {
          route: "/alerts/",
          showBars: true,
          source: `---
title: 天气预警
description: 每小时更新的城市气象数据。
---

每小时气象推送，覆盖任意城市。
额度规则详见 [配额说明](/docs/quota)。

<Aside type="note">
  数据每 10 分钟与观测站同步一次。
</Aside>`,
        },
        openapi: {
          route: "/api/weather/",
          showBars: false,
          source: `---
title: 气象接口规范
description: 从远程 URL 读取并预处理 OpenAPI 文档。
---

在配置中声明远程规范地址，参见 [URL 与转换](/api-reference/openapi/spec-sources)。

\`\`\`ts
export default {
  api: [{ collection: "api", spec: { source: "weather" } }],
};
\`\`\`

<Aside type="tip">
  设置 integrity 摘要后可实现离线可复现构建。
</Aside>`,
        },
        migrate: {
          route: "/migrate/",
          showBars: false,
          source: `---
title: 迁移到 Nimbus
description: 保留原有全部 URL 与导航结构。
---

运行内置迁移配方，详见 [重定向配置](/navigation/redirects)。

\`\`\`sh
npx @cloudflare/nimbus-docs add migrate
\`\`\`

<Aside type="note">
  报告会列出未能自动转换的自定义嵌入内容。
</Aside>`,
        },
      };

      let activeFileKey = "alerts";
      const fileButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-file-preset]"));
      const editorInput = root.querySelector<HTMLTextAreaElement>("[data-editor-input]");
      const editorLines = root.querySelector<HTMLElement>("[data-editor-lines]");
      const lintBtn = root.querySelector<HTMLButtonElement>("[data-lint-action]");
      const checksSummary = root.querySelector<HTMLElement>("[data-checks-summary]");
      const checkItems = Array.from(root.querySelectorAll<HTMLElement>("[data-check-item]"));
      const htmlContainers = Array.from(root.querySelectorAll<HTMLElement>("[data-live-html]"));
      const mdContainers = Array.from(root.querySelectorAll<HTMLElement>("[data-live-md]"));
      const llmsContainer = root.querySelector<HTMLElement>("[data-live-llms]");
      const xrayRouteLeft = root.querySelector<HTMLElement>("[data-xray-route-left]");
      const xrayRouteRight = root.querySelector<HTMLElement>("[data-xray-route-right]");
      const htmlRouteEl = root.querySelector<HTMLElement>("[data-html-route]");
      const mdRouteEl = root.querySelector<HTMLElement>("[data-md-route]");

      interface ParsedBlock {
        kind: "heading" | "paragraph" | "code" | "callout";
        text: string;
        lang?: string;
        links?: Array<{ label: string; url: string; broken: boolean }>;
      }

      const compileMdx = (raw: string) => {
        const normalized = raw.replace(/\r\n/g, "\n");
        let title = "";
        let description = "";
        let body = normalized;
        let hasValidFm = false;

        const fmMatch = normalized.match(/^---\n([\s\S]*?)\n---(?:\n|$)/);
        if (fmMatch) {
          const fmBody = fmMatch[1] ?? "";
          body = normalized.slice(fmMatch[0].length);
          const titleMatch = fmBody.match(/^title:\s*(.+)$/m);
          const descMatch = fmBody.match(/^description:\s*(.+)$/m);
          title = titleMatch?.[1]?.trim().replace(/^["']|["']$/g, "") ?? "";
          description = descMatch?.[1]?.trim().replace(/^["']|["']$/g, "") ?? "";
          hasValidFm = title.length > 0;
        }

        const blocks: ParsedBlock[] = [];
        const lines = body.split("\n");
        let i = 0;
        let inCode = false;
        let codeLang = "";
        let codeLines: string[] = [];
        let linksOk = true;
        let headingsOk = true;
        let codeOk = true;
        let prevLevel = 1;
        let paraBuffer: string[] = [];

        const flushPara = () => {
          const text = paraBuffer.join(" ").trim();
          paraBuffer = [];
          if (!text) return;
          const links: Array<{ label: string; url: string; broken: boolean }> = [];
          const linkRegex = /\[([^\]]+)\]\(([^)]*)\)/g;
          let m: RegExpExecArray | null;
          while ((m = linkRegex.exec(text)) !== null) {
            const url = (m[2] ?? "").trim();
            const broken = !url || /broken|404|todo/i.test(url);
            if (broken) linksOk = false;
            links.push({ label: m[1] ?? "", url, broken });
          }
          blocks.push({ kind: "paragraph", text, links });
        };

        while (i < lines.length) {
          const line = lines[i] ?? "";
          if (inCode) {
            if (line.trim().startsWith("```")) {
              blocks.push({ kind: "code", text: codeLines.join("\n"), lang: codeLang });
              inCode = false;
              codeLines = [];
              codeLang = "";
            } else {
              codeLines.push(line);
            }
            i++;
            continue;
          }

          if (line.trim().startsWith("```")) {
            flushPara();
            codeLang = line.trim().slice(3).trim();
            if (!codeLang) codeOk = false;
            inCode = true;
            i++;
            continue;
          }

          const asideOpen = line.trim().match(/^<Aside\b[^>]*>$/);
          if (asideOpen) {
            flushPara();
            const asideLines: string[] = [];
            i++;
            while (i < lines.length && !(lines[i] ?? "").trim().startsWith("</Aside>")) {
              asideLines.push((lines[i] ?? "").trim());
              i++;
            }
            blocks.push({ kind: "callout", text: asideLines.join(" ") });
            i++;
            continue;
          }

          const headingMatch = line.match(/^(#{1,6})\s+(.+)$/);
          if (headingMatch) {
            flushPara();
            const level = headingMatch[1]?.length ?? 2;
            if (level - prevLevel > 1) headingsOk = false;
            prevLevel = level;
            blocks.push({ kind: "heading", text: headingMatch[2] ?? "" });
            i++;
            continue;
          }

          if (line.trim() === "") {
            flushPara();
            i++;
            continue;
          }

          paraBuffer.push(line.trim());
          i++;
        }
        flushPara();

        const route = filePresets[activeFileKey]?.route ?? "/alerts/";
        const mdRoute = `${route}index.md`;
        const mdParts: string[] = [`# ${title || "未命名文档"}`];
        if (description) mdParts.push("", description);
        for (const b of blocks) {
          if (b.kind === "heading") {
            mdParts.push("", `## ${b.text}`);
          } else if (b.kind === "paragraph") {
            const rewritten = b.text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_all, lbl, url) => {
              const target = url.endsWith(".md") ? url : `${url.replace(/\/$/, "")}/index.md`;
              return `[${lbl}](${target})`;
            });
            mdParts.push("", rewritten);
          } else if (b.kind === "code") {
            mdParts.push("", `\`\`\`${b.lang ?? ""}\n${b.text}\n\`\`\``);
          } else if (b.kind === "callout") {
            mdParts.push("", `> **提示**\n> ${b.text}`);
          }
        }

        const markdown = mdParts.join("\n");
        const llms = `# Nimbus 文档站\n\n> 面向人与智能体的文档入口。\n\n## 当前页面\n\n- [${title || "未命名文档"}](${mdRoute}): ${description || "待补充页面摘要。"}\n- [配额说明](/docs/quota/index.md): 账户速率限制与配额查看方式。\n\n## 坐标清单\n\n- /nimbus-api/coordinates.json`;
        const tokenEstimate = Math.max(24, Math.round(markdown.length * 0.72));

        return {
          title: title || "缺少标题",
          hasTitle: title.length > 0,
          description,
          blocks,
          markdown,
          llms,
          route,
          mdRoute,
          tokenEstimate,
          checks: {
            links: linksOk,
            frontmatter: hasValidFm,
            headings: headingsOk,
            code: codeOk,
          },
        };
      };

      const appendParagraphWithLinks = (el: HTMLElement, text: string) => {
        const regex = /\[([^\]]+)\]\(([^)]*)\)/g;
        let last = 0;
        let m: RegExpExecArray | null;
        while ((m = regex.exec(text)) !== null) {
          if (m.index > last) {
            el.appendChild(document.createTextNode(text.slice(last, m.index)));
          }
          const span = document.createElement("span");
          const url = (m[2] ?? "").trim();
          const broken = !url || /broken|404|todo/i.test(url);
          span.className = broken ? "lp-inline-link is-broken" : "lp-inline-link";
          span.textContent = m[1] ?? "";
          el.appendChild(span);
          last = regex.lastIndex;
        }
        if (last < text.length) {
          el.appendChild(document.createTextNode(text.slice(last)));
        }
      };

      const renderLiveStage = () => {
        if (!editorInput) return;
        const raw = editorInput.value;
        const lineCount = raw.split("\n").length;
        if (editorLines) {
          editorLines.textContent = Array.from({ length: lineCount }, (_, idx) => idx + 1).join("\n");
        }

        const parsed = compileMdx(raw);

        // 更新路由与 token 统计
        if (xrayRouteLeft) xrayRouteLeft.textContent = `人类网页 · ${parsed.route}`;
        if (xrayRouteRight) {
          xrayRouteRight.textContent = `智能体 Markdown · ${parsed.mdRoute} · ~${parsed.tokenEstimate} tokens`;
        }
        if (htmlRouteEl) htmlRouteEl.textContent = `路由 ${parsed.route}`;
        if (mdRouteEl) mdRouteEl.textContent = `路由 ${parsed.mdRoute}`;

        // 更新 4 项静态校验状态
        const checkStates = parsed.checks as Record<string, boolean>;
        let passCount = 0;
        for (const item of checkItems) {
          const key = item.dataset.checkItem ?? "";
          const ok = checkStates[key] !== false;
          if (ok) passCount++;
          item.setAttribute("data-check-ok", String(ok));
        }
        const allOk = passCount === checkItems.length;
        if (checksSummary) {
          checksSummary.textContent = allOk
            ? `nimbus-docs check · ${passCount} 项通过`
            : `nimbus-docs check · ${checkItems.length - passCount} 项异常`;
          checksSummary.classList.toggle("is-failing", !allOk);
        }
        if (lintBtn) {
          lintBtn.dataset.lintMode = allOk ? "break" : "fix";
          lintBtn.textContent = allOk ? "注入错误" : "运行 --fix";
        }

        // 安全 DOM 构建 HTML 预览层（同步到 X-Ray 底层与 人类网页 独立选项卡）
        for (const container of htmlContainers) {
          container.replaceChildren();
          const titleEl = document.createElement("p");
          titleEl.className = parsed.hasTitle ? "lp-doc-preview-title" : "lp-doc-preview-title is-missing";
          titleEl.textContent = parsed.title;
          container.appendChild(titleEl);

          if (parsed.description) {
            const descEl = document.createElement("p");
            descEl.className = "lp-doc-preview-copy";
            descEl.textContent = parsed.description;
            container.appendChild(descEl);
          }

          for (const block of parsed.blocks) {
            if (block.kind === "heading") {
              const hEl = document.createElement("p");
              hEl.className = "lp-doc-preview-subhead";
              hEl.textContent = block.text;
              container.appendChild(hEl);
            } else if (block.kind === "paragraph") {
              const pEl = document.createElement("p");
              pEl.className = "lp-doc-preview-copy";
              appendParagraphWithLinks(pEl, block.text);
              container.appendChild(pEl);
            } else if (block.kind === "code") {
              const pre = document.createElement("pre");
              pre.className = "lp-doc-inline-code";
              const code = document.createElement("code");
              code.textContent = block.text;
              pre.appendChild(code);
              container.appendChild(pre);
            } else if (block.kind === "callout") {
              const callout = document.createElement("div");
              callout.className = "lp-doc-callout";
              const strong = document.createElement("strong");
              strong.textContent = "提示";
              const span = document.createElement("span");
              span.textContent = block.text;
              callout.append(strong, span);
              container.appendChild(callout);
            }
          }

          if (filePresets[activeFileKey]?.showBars) {
            const bars = document.createElement("div");
            bars.className = "lp-doc-bars";
            bars.setAttribute("aria-label", "实时城市温度示例");
            const cities: Array<[string, string, string]> = [
              ["北京", "62%", "22°C"],
              ["上海", "78%", "26°C"],
              ["深圳", "88%", "29°C"],
            ];
            for (const [city, w, temp] of cities) {
              const row = document.createElement("div");
              row.className = "lp-doc-bar-row";
              const cSpan = document.createElement("span");
              cSpan.textContent = city;
              const track = document.createElement("span");
              track.className = "lp-doc-bar-track";
              const fill = document.createElement("i");
              fill.style.width = w;
              track.appendChild(fill);
              const tSpan = document.createElement("span");
              tSpan.textContent = temp;
              row.append(cSpan, track, tSpan);
              bars.appendChild(row);
            }
            const firstCallout = container.querySelector(".lp-doc-callout");
            if (firstCallout) container.insertBefore(bars, firstCallout);
            else container.appendChild(bars);
          }
        }

        // 更新 Markdown 与 llms.txt 输出
        for (const mdNode of mdContainers) {
          const code = mdNode.querySelector("code") ?? mdNode;
          code.textContent = parsed.markdown;
        }
        if (llmsContainer) {
          const code = llmsContainer.querySelector("code") ?? llmsContainer;
          code.textContent = parsed.llms;
        }
      };

      const onEditorInput = () => renderLiveStage();
      const onEditorScroll = () => {
        if (editorInput && editorLines) {
          editorLines.scrollTop = editorInput.scrollTop;
        }
      };
      editorInput?.addEventListener("input", onEditorInput);
      editorInput?.addEventListener("scroll", onEditorScroll);

      const onFileClick = (e: Event) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const key = btn.dataset.filePreset;
        if (!key || !filePresets[key] || !editorInput) return;
        activeFileKey = key;
        editorInput.value = filePresets[key].source;
        for (const item of fileButtons) {
          item.setAttribute("aria-checked", String(item === btn));
        }
        renderLiveStage();
      };
      fileButtons.forEach((btn) => btn.addEventListener("click", onFileClick));

      const onLintActionClick = () => {
        if (!editorInput || !lintBtn) return;
        if (lintBtn.dataset.lintMode === "break") {
          let broken = editorInput.value
            .replace(/^title:.*\n?/m, "")
            .replace(/\]\([^)]+\)/, "](/docs/broken-link)")
            .replace(/```[a-z]+/g, "```");
          if (broken === editorInput.value) {
            broken = `${editorInput.value}\n\n#### 跳级标题\n见 [失效链接](/docs/broken-link)。`;
          } else {
            broken = `${broken}\n\n#### 跳级标题`;
          }
          editorInput.value = broken;
        } else {
          const preset = filePresets[activeFileKey];
          if (preset) editorInput.value = preset.source;
        }
        renderLiveStage();
      };
      lintBtn?.addEventListener("click", onLintActionClick);

      // Band 1: X-Ray 透视对照可拖拽幕帘
      const xrayStage = root.querySelector<HTMLElement>("[data-xray-stage]");
      const xrayHandle = root.querySelector<HTMLButtonElement>("[data-xray-handle]");
      let splitPct = 56;
      let dragging = false;

      const setSplit = (pct: number) => {
        splitPct = Math.min(85, Math.max(15, Math.round(pct)));
        xrayStage?.style.setProperty("--split", `${splitPct}%`);
        xrayHandle?.setAttribute("aria-valuenow", String(splitPct));
      };

      const updateSplitFromClientX = (clientX: number) => {
        if (!xrayStage) return;
        const rect = xrayStage.getBoundingClientRect();
        if (rect.width <= 0) return;
        setSplit(((clientX - rect.left) / rect.width) * 100);
      };

      const onHandlePointerDown = (e: PointerEvent) => {
        if (!xrayHandle) return;
        dragging = true;
        xrayHandle.setPointerCapture(e.pointerId);
        updateSplitFromClientX(e.clientX);
      };

      const onHandlePointerMove = (e: PointerEvent) => {
        if (!dragging) return;
        updateSplitFromClientX(e.clientX);
      };

      const onHandlePointerUp = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        if (xrayHandle?.hasPointerCapture(e.pointerId)) {
          xrayHandle.releasePointerCapture(e.pointerId);
        }
      };

      const onStagePointerDown = (e: PointerEvent) => {
        if (e.target === xrayHandle || xrayHandle?.contains(e.target as Node)) return;
        updateSplitFromClientX(e.clientX);
      };

      const onHandleKeyDown = (e: KeyboardEvent) => {
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          setSplit(splitPct - 5);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          setSplit(splitPct + 5);
        }
      };

      xrayHandle?.addEventListener("pointerdown", onHandlePointerDown);
      xrayHandle?.addEventListener("pointermove", onHandlePointerMove);
      xrayHandle?.addEventListener("pointerup", onHandlePointerUp);
      xrayHandle?.addEventListener("pointercancel", onHandlePointerUp);
      xrayHandle?.addEventListener("keydown", onHandleKeyDown);
      xrayStage?.addEventListener("pointerdown", onStagePointerDown);

      renderLiveStage();

      // Band 2: 签核开关
      const reviewSwitch = root.querySelector<HTMLButtonElement>("[data-review-switch]");
      const reviewStatus = root.querySelector<HTMLElement>("[data-review-status]");
      const reviewNote = root.querySelector<HTMLElement>("[data-review-note]");

      const onReviewToggle = () => {
        if (!reviewSwitch) return;
        const approved = reviewSwitch.getAttribute("aria-checked") !== "true";
        reviewSwitch.setAttribute("aria-checked", String(approved));
        if (reviewStatus) {
          reviewStatus.textContent = approved ? "当前状态：已签核并放行发布" : "当前状态：等待评审签核";
        }
        if (reviewNote) {
          reviewNote.textContent = approved
            ? "评审已签核，合并后即同步构建 HTML、Markdown 与 llms.txt。"
            : "草稿暂存于预览分支，点击右侧开关模拟评审通过并放行构建。";
        }
      };
      reviewSwitch?.addEventListener("click", onReviewToggle);

      // Band 3: 主题令牌交互工坊
      const atelier = root.querySelector<HTMLElement>("[data-theme-atelier]");
      const brandCode = atelier?.querySelector<HTMLElement>('[data-theme-token="brand"]');
      const radiusCode = atelier?.querySelector<HTMLElement>('[data-theme-token="radius"]');
      const themeOptions = Array.from(
        atelier?.querySelectorAll<HTMLButtonElement>("[data-theme-option]") ?? [],
      );

      const applyThemeOption = (btn: HTMLButtonElement) => {
        if (!atelier) return;
        const brand = btn.dataset.brand ?? "";
        const color = btn.dataset.color ?? "";
        const radius = btn.dataset.radius ?? "";
        if (color === "mono" || !color) {
          atelier.style.removeProperty("--atelier-brand");
          atelier.style.removeProperty("--atelier-btn-ink");
        } else {
          atelier.style.setProperty("--atelier-brand", color);
          atelier.style.setProperty("--atelier-btn-ink", "#ffffff");
        }
        atelier.style.setProperty("--atelier-radius", radius);
        if (brandCode) brandCode.textContent = brand;
        if (radiusCode) radiusCode.textContent = radius;
        for (const opt of themeOptions) {
          opt.setAttribute("aria-checked", String(opt === btn));
        }
      };

      const onThemeOptionClick = (e: Event) => {
        applyThemeOption(e.currentTarget as HTMLButtonElement);
      };
      themeOptions.forEach((opt) => opt.addEventListener("click", onThemeOptionClick));

      // Band 4: OpenAPI 试调展台交互
      const apiStage = root.querySelector<HTMLElement>("[data-api-stage]");
      const apiEpButtons = Array.from(
        apiStage?.querySelectorAll<HTMLButtonElement>("[data-api-endpoint]") ?? [],
      );
      const apiLangButtons = Array.from(
        apiStage?.querySelectorAll<HTMLButtonElement>("[data-api-lang]") ?? [],
      );
      const apiOpIdEl = apiStage?.querySelector<HTMLElement>("[data-api-op-id]");
      const apiReqEl = apiStage?.querySelector<HTMLElement>("[data-api-request]");
      const apiResEl = apiStage?.querySelector<HTMLElement>("[data-api-response]");
      const apiStatusEl = apiStage?.querySelector<HTMLElement>("[data-api-status]");
      const apiSendBtn = apiStage?.querySelector<HTMLButtonElement>("[data-api-send]");

      const apiSpecs: Record<
        string,
        {
          opId: string;
          statusText: string;
          samples: Record<string, string>;
          response: string;
        }
      > = {
        forecast: {
          opId: "operationId: getForecast",
          statusText: "200 OK · 18 ms",
          samples: {
            curl: `curl -X GET "https://api.weather.example/v2/forecast?city=shanghai" \\\n  -H "Authorization: Bearer nb_live_94f2a8c" \\\n  -H "Accept: application/json"`,
            ts: `const res = await fetch("https://api.weather.example/v2/forecast?city=shanghai", {\n  headers: { Authorization: "Bearer nb_live_94f2a8c" },\n});\nconst data = await res.json();`,
            py: `import httpx\n\nres = httpx.get(\n  "https://api.weather.example/v2/forecast",\n  params={"city": "shanghai"},\n  headers={"Authorization": "Bearer nb_live_94f2a8c"},\n)`,
          },
          response: `{\n  "city": "Shanghai",\n  "temperature_c": 26,\n  "condition": "Clear",\n  "updated_at": "2026-11-25T15:00:00Z"\n}`,
        },
        alerts: {
          opId: "operationId: createAlertRule",
          statusText: "201 Created · 24 ms",
          samples: {
            curl: `curl -X POST "https://api.weather.example/v2/alerts" \\\n  -H "Authorization: Bearer nb_live_94f2a8c" \\\n  -H "Content-Type: application/json" \\\n  -d '{"city":"Beijing","threshold_c":35}'`,
            ts: `const res = await fetch("https://api.weather.example/v2/alerts", {\n  method: "POST",\n  headers: { Authorization: "Bearer nb_live_94f2a8c", "Content-Type": "application/json" },\n  body: JSON.stringify({ city: "Beijing", threshold_c: 35 }),\n});`,
            py: `import httpx\n\nres = httpx.post(\n  "https://api.weather.example/v2/alerts",\n  headers={"Authorization": "Bearer nb_live_94f2a8c"},\n  json={"city": "Beijing", "threshold_c": 35},\n)`,
          },
          response: `{\n  "id": "alrt_01jf9x2k",\n  "city": "Beijing",\n  "threshold_c": 35,\n  "active": true\n}`,
        },
      };

      let currentEndpoint = "forecast";
      let currentLang = "curl";

      const renderApiStage = (sent = false) => {
        const spec = apiSpecs[currentEndpoint];
        if (!spec) return;
        if (apiOpIdEl) apiOpIdEl.textContent = spec.opId;
        if (apiReqEl) {
          const code = apiReqEl.querySelector("code") ?? apiReqEl;
          code.textContent = spec.samples[currentLang] ?? "";
        }
        if (apiResEl) {
          const code = apiResEl.querySelector("code") ?? apiResEl;
          code.textContent = spec.response;
          if (sent) {
            apiResEl.classList.remove("is-pulsing");
            void apiResEl.offsetWidth;
            apiResEl.classList.add("is-pulsing");
          }
        }
        if (apiStatusEl) {
          apiStatusEl.textContent = sent ? spec.statusText : "待发送 · 点击按钮试调";
          apiStatusEl.classList.toggle("is-sent", sent);
        }
      };

      const onApiEndpointClick = (e: Event) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const ep = btn.dataset.apiEndpoint;
        if (!ep || !apiSpecs[ep]) return;
        currentEndpoint = ep;
        for (const item of apiEpButtons) {
          item.setAttribute("aria-checked", String(item === btn));
        }
        renderApiStage(false);
      };

      const onApiLangClick = (e: Event) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const lang = btn.dataset.apiLang;
        if (!lang) return;
        currentLang = lang;
        for (const item of apiLangButtons) {
          const active = item === btn;
          item.setAttribute("aria-selected", String(active));
          item.tabIndex = active ? 0 : -1;
        }
        renderApiStage(false);
      };

      const onApiSendClick = () => renderApiStage(true);

      apiEpButtons.forEach((btn) => btn.addEventListener("click", onApiEndpointClick));
      apiLangButtons.forEach((btn) => btn.addEventListener("click", onApiLangClick));
      apiSendBtn?.addEventListener("click", onApiSendClick);

      // Band 5: 本地即时搜索沙盒（支持关键词输入、高亮与版本过滤）
      const kbd = root.querySelector<HTMLElement>("[data-search-kbd]");
      if (kbd) {
        const isApple = /Mac|iPhone|iPad|iPod/i.test(navigator.platform || navigator.userAgent);
        kbd.textContent = isApple ? "⌘K" : "Ctrl K";
      }

      interface SandboxDoc {
        title: string;
        desc: string;
        meta: string;
        deprecated: boolean;
      }

      const sandboxCorpus: SandboxDoc[] = [
        {
          title: "迁移到 Nimbus",
          desc: "保留所有原有 URL、frontmatter、导航结构与组件，支持编码智能体一键迁移或七步手动完成。",
          meta: "/migrate/ · 当前版本",
          deprecated: false,
        },
        {
          title: "OpenAPI 远程规范与转换",
          desc: "声明带 integrity 校验的 URL 来源，并在渲染前使用 transform 函数预处理解析后的规范。",
          meta: "/api-reference/openapi/spec-sources/ · 当前版本",
          deprecated: false,
        },
        {
          title: "远程 MCP 服务器",
          desc: "把站内文档与 API 坐标封装为智能体可调用的工具端点，支持身份校验与按需查询。",
          meta: "/ai/remote-mcp/ · 当前版本",
          deprecated: false,
        },
        {
          title: "旧版路由配置（v1）",
          desc: "v1 版本的路径映射说明，仅在开启已弃用版本检索时展示用于历史项目查阅。",
          meta: "/v1/routes/ · 已弃用 v1",
          deprecated: true,
        },
      ];

      const sandboxInput = root.querySelector<HTMLInputElement>("[data-sandbox-input]");
      const sandboxResults = root.querySelector<HTMLElement>("[data-sandbox-results]");
      const sandboxCount = root.querySelector<HTMLElement>("[data-sandbox-count]");
      const versionSwitch = root.querySelector<HTMLButtonElement>("[data-version-switch]");
      const presetButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-search-preset]"),
      );

      let hideDeprecated = true;

      const appendHighlightedText = (parent: HTMLElement, text: string, query: string) => {
        if (!query) {
          parent.textContent = text;
          return;
        }
        const lowerText = text.toLowerCase();
        const lowerQuery = query.toLowerCase();
        let start = 0;
        let idx = lowerText.indexOf(lowerQuery, start);
        while (idx !== -1) {
          if (idx > start) {
            parent.appendChild(document.createTextNode(text.slice(start, idx)));
          }
          const mark = document.createElement("mark");
          mark.className = "lp-search-mark";
          mark.textContent = text.slice(idx, idx + query.length);
          parent.appendChild(mark);
          start = idx + query.length;
          idx = lowerText.indexOf(lowerQuery, start);
        }
        if (start < text.length) {
          parent.appendChild(document.createTextNode(text.slice(start)));
        }
      };

      const renderSearchSandbox = () => {
        if (!sandboxResults) return;
        const query = (sandboxInput?.value ?? "").trim();
        const qLower = query.toLowerCase();

        const visible = sandboxCorpus.filter((doc) => {
          if (hideDeprecated && doc.deprecated) return false;
          if (!qLower) return true;
          return (
            doc.title.toLowerCase().includes(qLower) ||
            doc.desc.toLowerCase().includes(qLower) ||
            doc.meta.toLowerCase().includes(qLower)
          );
        });

        sandboxResults.replaceChildren();
        if (visible.length === 0) {
          const empty = document.createElement("div");
          empty.className = "lp-search-empty";
          empty.textContent = hideDeprecated
            ? "当前版本未命中结果，可尝试关闭右上角“隐藏已弃用 v1”开关或更换关键词。"
            : "未找到匹配条目，请尝试搜索 迁移、OpenAPI、MCP 或 v1。";
          sandboxResults.appendChild(empty);
        } else {
          for (const doc of visible.slice(0, 4)) {
            const row = document.createElement("div");
            row.className = doc.deprecated ? "lp-search-result-row is-deprecated" : "lp-search-result-row";
            const main = document.createElement("div");
            main.className = "lp-search-result-main";
            const strong = document.createElement("strong");
            appendHighlightedText(strong, doc.title, query);
            const span = document.createElement("span");
            appendHighlightedText(span, doc.desc, query);
            main.append(strong, span);
            const code = document.createElement("code");
            appendHighlightedText(code, doc.meta, query);
            row.append(main, code);
            sandboxResults.appendChild(row);
          }
        }

        if (sandboxCount) {
          const hiddenCount = hideDeprecated
            ? sandboxCorpus.filter((d) => d.deprecated).length
            : 0;
          sandboxCount.textContent = hideDeprecated
            ? `当前命中 ${visible.length} 条结果 · 已过滤 ${hiddenCount} 条已弃用 v1 文档`
            : `当前命中 ${visible.length} 条结果 · 包含历史已弃用版本`;
        }
      };

      const onSandboxInput = () => {
        const val = (sandboxInput?.value ?? "").trim();
        for (const btn of presetButtons) {
          btn.setAttribute("aria-checked", String((btn.dataset.searchPreset ?? "") === val));
        }
        renderSearchSandbox();
      };

      const onPresetClick = (e: Event) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const preset = btn.dataset.searchPreset ?? "";
        if (sandboxInput) sandboxInput.value = preset;
        for (const item of presetButtons) {
          item.setAttribute("aria-checked", String(item === btn));
        }
        renderSearchSandbox();
      };

      const onVersionToggle = () => {
        if (!versionSwitch) return;
        hideDeprecated = versionSwitch.getAttribute("aria-checked") !== "true";
        versionSwitch.setAttribute("aria-checked", String(hideDeprecated));
        renderSearchSandbox();
      };

      sandboxInput?.addEventListener("input", onSandboxInput);
      presetButtons.forEach((btn) => btn.addEventListener("click", onPresetClick));
      versionSwitch?.addEventListener("click", onVersionToggle);
      renderSearchSandbox();

      // 次级区块的克制滚动显现
      const revealTargets = Array.from(
        root.querySelectorAll<HTMLElement>("main > section:not(.lp-hero) > .lp-container"),
      );
      let revealObserver: IntersectionObserver | undefined;
      let revealRaf = 0;

      const pending: HTMLElement[] = [];

      const revealEl = (el: Element) => {
        el.classList.add("is-visible");
        revealObserver?.unobserve(el);
      };

      const syncVisible = () => {
        if (revealRaf) return;
        revealRaf = window.requestAnimationFrame(() => {
          revealRaf = 0;
          const cutoff = window.innerHeight * 0.96;
          for (const el of pending) {
            if (el.classList.contains("is-visible")) continue;
            if (el.getBoundingClientRect().top < cutoff) revealEl(el);
          }
        });
      };

      if (!reducedMotion && "IntersectionObserver" in window && revealTargets.length > 0) {
        revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) revealEl(entry.target);
            }
          },
          { rootMargin: "0px 0px -4% 0px", threshold: 0.01 },
        );

        for (const el of revealTargets) {
          if (el.getBoundingClientRect().top < window.innerHeight * 0.95) continue;
          el.classList.add("lp-reveal");
          pending.push(el);
          revealObserver.observe(el);
        }

        window.addEventListener("scroll", syncVisible, { passive: true });
        window.addEventListener("hashchange", syncVisible);
      }

      return () => {
        window.removeEventListener("scroll", updateHeader);
        heroEl?.removeEventListener("pointermove", onHeroPointerMove);
        heroEl?.removeEventListener("pointerleave", onHeroPointerLeave);
        if (heroGridRaf) window.cancelAnimationFrame(heroGridRaf);
        pmButtons.forEach((btn) => btn.removeEventListener("click", onPmClick));
        editorInput?.removeEventListener("input", onEditorInput);
        editorInput?.removeEventListener("scroll", onEditorScroll);
        fileButtons.forEach((btn) => btn.removeEventListener("click", onFileClick));
        lintBtn?.removeEventListener("click", onLintActionClick);
        xrayHandle?.removeEventListener("pointerdown", onHandlePointerDown);
        xrayHandle?.removeEventListener("pointermove", onHandlePointerMove);
        xrayHandle?.removeEventListener("pointerup", onHandlePointerUp);
        xrayHandle?.removeEventListener("pointercancel", onHandlePointerUp);
        xrayHandle?.removeEventListener("keydown", onHandleKeyDown);
        xrayStage?.removeEventListener("pointerdown", onStagePointerDown);
        stageTabs.forEach((tab) => {
          tab.removeEventListener("click", onStageClick);
          tab.removeEventListener("keydown", onStageKeyDown);
        });
        reviewSwitch?.removeEventListener("click", onReviewToggle);
        themeOptions.forEach((opt) => opt.removeEventListener("click", onThemeOptionClick));
        apiEpButtons.forEach((btn) => btn.removeEventListener("click", onApiEndpointClick));
        apiLangButtons.forEach((btn) => btn.removeEventListener("click", onApiLangClick));
        apiSendBtn?.removeEventListener("click", onApiSendClick);
        sandboxInput?.removeEventListener("input", onSandboxInput);
        presetButtons.forEach((btn) => btn.removeEventListener("click", onPresetClick));
        versionSwitch?.removeEventListener("click", onVersionToggle);
        revealObserver?.disconnect();
        window.removeEventListener("scroll", syncVisible);
        window.removeEventListener("hashchange", syncVisible);
        if (revealRaf) window.cancelAnimationFrame(revealRaf);
      };
    });

    // 命令复制交互（无废弃 API）
    mount("[data-copy-command]", (root) => {
      const button = root.querySelector<HTMLButtonElement>("[data-copy-trigger]");
      const label = root.querySelector<HTMLElement>("[data-copy-label]");
      const codeNode = root.querySelector<HTMLElement>("[data-copy-code]");
      if (!button || !label) return () => {};
      const original = label.textContent ?? "复制";
      const text = root.getAttribute("data-copy-value") ?? "";
      let timer: number | undefined;

      const onClick = async () => {
        let copied = false;
        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(text);
            copied = true;
          } catch {
            copied = false;
          }
        }

        if (!copied && codeNode) {
          const selection = window.getSelection();
          if (selection) {
            const range = document.createRange();
            range.selectNodeContents(codeNode);
            selection.removeAllRanges();
            selection.addRange(range);
          }
        }

        label.textContent = copied ? "已复制" : "已选中";
        button.dataset.copied = copied ? "true" : "false";
        if (timer) window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          label.textContent = original;
          delete button.dataset.copied;
        }, 1800);
      };

      button.addEventListener("click", onClick);
      return () => {
        button.removeEventListener("click", onClick);
        if (timer) window.clearTimeout(timer);
      };
    });
  </script>
</BaseLayout>

