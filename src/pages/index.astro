  <script>
    import { mount } from "@cloudflare/nimbus-docs/client";

    mount("[data-copy-command]", (root) => {
      const button = root.querySelector("[data-copy-trigger]") as HTMLButtonElement | null;
      const label = root.querySelector("[data-copy-label]") as HTMLElement | null;
      if (!button || !label) return () => {};
      const original = label.textContent;
      const text = root.getAttribute("data-copy-value") ?? "";
      let timer: number | undefined;

      const onClick = async () => {
        let copied = true;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const area = document.createElement("textarea");
          area.value = text;
          area.style.position = "fixed";
          area.style.opacity = "0";
          document.body.appendChild(area);
          area.select();
          copied = document.execCommand("copy");
          area.remove();
        }
        label.textContent = copied ? "已复制" : "复制失败";
        if (timer) window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          label.textContent = original;
        }, 1600);
      };

      button.addEventListener("click", onClick);
      return () => {
        button.removeEventListener("click", onClick);
        if (timer) window.clearTimeout(timer);
      };
    });
  </script>
